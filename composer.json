{
    "name": "php-anonymizer/anonymizer",
    "description": "A predictable, array-oriented PHP data anonymizer",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "thecodingmachine/safe": "^3.4",
        "webmozart/assert": "^2.5"
    },
    "suggest": {
        "php-anonymizer/anonymizer-bundle": "Add Symfony Bundle integration",
        "php-anonymizer/anonymizer-faker": "Add Faker replacement strategies",
        "php-anonymizer/anonymizer-laravel": "Add Laravel integration",
        "php-anonymizer/anonymizer-personas": "Add fixed European persona strategies",
        "php-anonymizer/anonymizer-pseudonymization": "Add keyed deterministic pseudonymisation",
        "php-anonymizer/anonymizer-symfony-serializer": "Add object anonymization through Symfony Serializer"
    },
    "autoload": {
        "psr-4": {
            "PhpAnonymizer\\Anonymizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpAnonymizer\\Anonymizer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "2.0.x-dev"
        }
    }
}
